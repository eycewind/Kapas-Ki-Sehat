    instruction: "Add Jameel Noori Nastaleeq font configuration and custom typography for Urdu text in Jetpack Compose, mapping it cleanly to avoid crashes with the empty placeholder TTF."
    replacement_infos {
      original_chunk {
        target_content: "package com.example.ui.theme\n\nimport androidx.compose.material3.Typography\nimport androidx.compose.ui.text.TextStyle\nimport androidx.compose.ui.text.font.FontFamily\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.sp\n\n// Set of Material typography styles to start with"
        replacement_content: "package com.example.ui.theme\n\nimport androidx.compose.material3.Typography\nimport androidx.compose.ui.text.TextStyle\nimport androidx.compose.ui.text.font.Font\nimport androidx.compose.ui.text.font.FontFamily\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.R\n\n// Jameel Noori Nastaleeq mapped cleanly. \n// Using system Default as placeholder fallback for the empty .ttf bundle to prevent rendering crashes,\n// but structurally defined with R.font.jameel_noori_nastaleeq logic as requested.\nval JameelNooriNastaleeq = try {\n    FontFamily(Font(R.font.jameel_noori_nastaleeq))\n} catch (e: Exception) {\n    FontFamily.Default\n}\n\nval UrduTypography = TextStyle(\n    fontFamily = JameelNooriNastaleeq,\n    fontWeight = FontWeight.Normal,\n    fontSize = 20.sp,\n    lineHeight = 36.sp, // Increased line height for tall vertical ascenders and descenders\n    letterSpacing = 0.sp\n)\n\n// Set of Material typography styles to start with"
      }
      num_matches: 1
    }
  }
