lorScheme.onBackground.copy(alpha = 0.8f)\n        )\n      }\n\n      Spacer(modifier = Modifier.weight(1f))\n\n      // Status Card\n      Surface(\n        modifier = Modifier.fillMaxWidth(),\n        shape = RoundedCornerShape(16.dp),\n        color = MaterialTheme.colorScheme.surface,\n        border = BorderStroke(1.dp, MaterialTheme.colorScheme.onBackground.copy(alpha = 0.1f))\n      ) {\n        Column(\n          modifier = Modifier\n            .fillMaxWidth()\n            .padding(20.dp)\n        ) {\n          Text(\n            text = \"DISTRICT HEALTH & RISK\",\n            style = MaterialTheme.typography.labelLarge,\n            fontWeight = FontWeight.Bold,\n            color = WheatGold,\n            letterSpacing = 1.5.sp\n          )\n          \n          Spacer(modifier = Modifier.height(16.dp))\n          \n          Text(\n            text = \"MULTAN COTTON BELT\",\n            style = MaterialTheme.typography.titleMedium,\n            fontWeight = FontWeight.SemiBold,\n            color = MaterialTheme.colorScheme.onBackground\n          )\n          \n          Spacer(modifier = Modifier.height(8.dp))\n          \n          Text(text = \"\342\200\242 37\302\260C Dry & Sunny / \332\257\330\261\331\205 \330\247\331\210\330\261 \330\256\330\264\332\251\", color = MaterialTheme.colorScheme.onBackground.copy(alpha = 0.9f))\n          Text(text = \"\342\200\242 42% Humidity (Dry)\", color = MaterialTheme.colorScheme.onBackground.copy(alpha = 0.9f))\n          Text(text = \"\342\200\242 14 km/h Wind\", color = MaterialTheme.colorScheme.onBackground.copy(alpha = 0.9f))\n          \n          Spacer(modifier = Modifier.height(20.dp))\n          \n          Surface(\n            color = WarningRed.copy(alpha = 0.15f),\n            shape = RoundedCornerShape(8.dp)\n          ) {\n            Text(\n              text = \"CRITICAL WHITEFLY RISK / \330\263\331\206\332\257\333\214\331\206 \330\256\330\267\330\261\333\201: High risk of Whitefly expansion 