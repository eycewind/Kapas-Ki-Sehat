# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# BACKEND_BASE_URL: FastAPI inference server.
# Override in your local .env (gitignored) — no Kotlin change or recompile needed.
# Examples:
#   LAN:   http://192.168.18.11:8000
#   ngrok: https://xxxx-xx-xx-xx-xx.ngrok-free.app
# Update this whenever you restart ngrok.
BACKEND_BASE_URL=http://192.168.18.11:8000
